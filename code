# 라이브러리 import
import pandas as pd

from openai import OpenAI

from langchain_community.vectorstores import FAISS
from langchain_huggingface import HuggingFaceEmbeddings

"""데이터 불러오기"""

PROJECT_PATH = "."

startup_df = pd.read_csv(
    f"{PROJECT_PATH}/data/processed/startup_business_processed.csv"
)

existing_df = pd.read_csv(
    f"{PROJECT_PATH}/data/processed/existing_business_processed.csv"
)

loan_df = pd.read_csv(
    f"{PROJECT_PATH}/data/financial_products_processed.csv"
)

"""정책 RAG"""

embedding = HuggingFaceEmbeddings(
    model_name="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
)

policy_db = FAISS.load_local(
    f"{PROJECT_PATH}/policy_faiss",
    embedding,
    allow_dangerous_deserialization=True
)

retriever = policy_db.as_retriever(
    search_kwargs={"k":5}
)

print("정책 DB 로드 완료")

"""Claude 연결"""

client = OpenAI(

    api_key="YOUR_API_KEY",

    base_url="YOUR_BASE_URL"

)

"""함수 모음"""

def make_profile(user):

    if user["business_stage"] == "예비창업":

        return f"""
창업단계 : {user["business_stage"]}
업종 : {user["industry"]}
지역 : {user["region"]}
연령 : {user["age"]}
창업자금 : {user["startup_capital"]}원
희망대출 : {user["desired_loan"]}원
신용점수 : {user["credit_score"]}
예상매출 : {user["expected_sales"]}원
창업경험 : {user["startup_experience"]}
"""

    return f"""
사업단계 : {user["business_stage"]}
업종 : {user["industry"]}
지역 : {user["region"]}
연령 : {user["age"]}
연매출 : {user["annual_sales"]}원
직원수 : {user["employee_count"]}명
기존대출 : {user["existing_loan"]}원
신용점수 : {user["credit_score"]}
사업자산 : {user["business_asset"]}원
사업연수 : {user["business_year"]}년
"""

def make_search_queries(profile):

    prompt = f"""
당신은 정책 검색 전문가입니다.

아래 사용자 정보를 보고
검색어를 3개 생성하세요.

{profile}

출력

1.
2.
3.
"""

    response = client.chat.completions.create(

        model="claude-sonnet-4-6",

        messages=[
            {
                "role":"user",
                "content":prompt
            }
        ],

        temperature=0
    )

    return response.choices[0].message.content

"""사용자 선택"""

# 예비창업자
user = startup_df.iloc[0]

# 기존사업자 테스트
# user = existing_df.iloc[0]

"""실행"""

search_query = make_search_queries(profile)

print(search_query)

queries = []

for line in search_query.split("\n"):

    line = line.strip()

    if len(line) == 0:
        continue

    line = line.replace("1.","")
    line = line.replace("2.","")
    line = line.replace("3.","")

    queries.append(line.strip())

all_docs = []

for q in queries:

    docs = retriever.invoke(q)

    all_docs.extend(docs)

unique_docs = []

seen = set()

for doc in all_docs:

    if doc.page_content not in seen:

        unique_docs.append(doc)

        seen.add(doc.page_content)

context = "\n\n".join(
    [doc.page_content for doc in unique_docs]
)

print("검색 정책 :", len(unique_docs))

"""금융 상품 추천"""

loan_recommend = loan_df.copy()

loan_recommend = loan_recommend[
    loan_recommend["lend_rate_avg"] > 0
]

loan_recommend["kb_priority"] = (
    loan_recommend["kor_co_nm"]=="국민은행"
)

loan_recommend = loan_recommend.sort_values(

    by=[
        "kb_priority",
        "lend_rate_avg"
    ],

    ascending=[
        False,
        True
    ]
)

loan_recommend = loan_recommend.drop_duplicates(

    subset="kor_co_nm",

    keep="first"
)

top_loans = loan_recommend.head(5)

loan_context = ""

for _, row in top_loans.iterrows():

    loan_context += f"""
은행 : {row['kor_co_nm']}
상품명 : {row['fin_prdt_nm']}
평균금리 : {row['lend_rate_avg']}%
대출한도 : {row['loan_limit']}
가입방법 : {row['join_way']}
"""

"""최종 ai 추천"""

final_prompt = f"""
당신은 KB국민은행 소상공인 금융 AI 컨설턴트입니다.

사용자 정보
--------------------
{profile}

정책 정보
--------------------
{context}

추천 가능한 금융상품
--------------------
{loan_context}

